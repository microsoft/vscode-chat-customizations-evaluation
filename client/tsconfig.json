{
  "compilerOptions": {
    "target": "ES2020",
    // Node16 resolution is required to read vscode-languageclient v10's "exports"
    // map. Under classic "node" resolution TypeScript cannot find its typings here
    // and silently falls back to the unrelated v9 copy hoisted at the repo root,
    // which hides real API breakages (see issues #276 and #284).
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2020"],
    "outDir": "./out",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out"]
}
